# Eye Health Assistant - Desktop App Environment Variables
# Copy this file to .env and adjust values as needed.
# The desktop app works without any environment variables for normal use.

# 
EYE_HEALTH_LOG_LEVEL=INFO
EYE_HEALTH_THEME=system

# Camera Setting
EYE_HEALTH_CAMERA_INDEX=0
EYE_HEALTH_CAMERA_WIDTH=640
EYE_HEALTH_CAMERA_HEIGHT=480
