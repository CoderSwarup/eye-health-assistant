# Eye Health Assistant - Web App Environment Variables
# Copy this file to .env.local and adjust values as needed.

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Download URLs (GitHub Releases page)
NEXT_PUBLIC_DOWNLOAD_WINDOWS_URL=https://github.com/CoderSwarup/eye-health-assistant/releases
NEXT_PUBLIC_DOWNLOAD_MACOS_URL=https://github.com/CoderSwarup/eye-health-assistant/releases
